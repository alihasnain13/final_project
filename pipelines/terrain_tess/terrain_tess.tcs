#version 410 core
layout (vertices = 4) out;        // still 4-point quad patches

// order: 0=TL, 1=BL, 2=BR, 3=TR
in  vec3 tcPosition[];
in  vec3 tcNormal[];
in  vec2 tcTexCoord[];

out vec3 tePosition[];
out vec3 teNormal[];
out vec2 teTexCoord[];

// ── camera matrices for LOD ─────────────────────────────
uniform mat4 uModel;
uniform mat4 uView;

// LOD parameters
const int   MIN_TESS_LEVEL = 2;
const int   MAX_TESS_LEVEL = 32;
const float MIN_DISTANCE   = 150.0;
const float MAX_DISTANCE   = 600.0;

void main()
{
    // pass-through for every invocation
    tePosition [gl_InvocationID] = tcPosition [gl_InvocationID];
    teNormal   [gl_InvocationID] = tcNormal   [gl_InvocationID];
    teTexCoord [gl_InvocationID] = tcTexCoord [gl_InvocationID];

    // set tess-levels only once
    if (gl_InvocationID == 0)
    {
       // --- 1. compute eye-space midpoint distances for each edge ---
    vec3 pTL = tcPosition[0];
    vec3 pBL = tcPosition[1];
    vec3 pBR = tcPosition[2];
    vec3 pTR = tcPosition[3];

    // midpoints on the world grid
    vec3 midBottom = (pBL + pBR) * 0.5;
    vec3 midLeft   = (pTL + pBL) * 0.5;
    vec3 midTop    = (pTR + pTL) * 0.5;
    vec3 midRight  = (pBR + pTR) * 0.5;

    // transform to eye‐space Z
    float dB = abs((uView * uModel * vec4(midBottom,1)).z);
    float dL = abs((uView * uModel * vec4(midLeft,  1)).z);
    float dT = abs((uView * uModel * vec4(midTop,   1)).z);
    float dR = abs((uView * uModel * vec4(midRight, 1)).z);

    // normalize into 0..1
    float sB = smoothstep(MIN_DISTANCE, MAX_DISTANCE, dB);
    float sL = smoothstep(MIN_DISTANCE, MAX_DISTANCE, dL);
    float sT = smoothstep(MIN_DISTANCE, MAX_DISTANCE, dT);
    float sR = smoothstep(MIN_DISTANCE, MAX_DISTANCE, dR);

    // --- 2. mix MAX/MIN by that midpoint factor ---
    float tB = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), sB);
    float tL = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), sL);
    float tT = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), sT);
    float tR = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), sR);

    // --- 3. assign to outer and inner levels ---
    gl_TessLevelOuter[0] = tB;      // bottom edge
    gl_TessLevelOuter[1] = tL;      // left edge
    gl_TessLevelOuter[2] = tT;      // top edge
    gl_TessLevelOuter[3] = tR;      // right edge

    // inner = max of opposite edges
    gl_TessLevelInner[0] = max(tL, tR);  // U direction
    gl_TessLevelInner[1] = max(tT, tB);  // V direction
    }
}
