#version 410 core
layout (vertices = 4) out;        // still 4-point quad patches

// order: 0=TL, 1=BL, 2=BR, 3=TR
in  vec3 tcPosition[];
in  vec3 tcNormal[];
in  vec2 tcTexCoord[];

out vec3 tePosition[];
out vec3 teNormal[];
out vec2 teTexCoord[];

// ── camera matrices for LOD ─────────────────────────────
uniform mat4 uModel;
uniform mat4 uView;

// LOD parameters
const int   MIN_TESS_LEVEL = 2;
const int   MAX_TESS_LEVEL = 64;
const float MIN_DISTANCE   = 200.0;
const float MAX_DISTANCE   = 800.0;

void main()
{
    // pass-through for every invocation
    tePosition [gl_InvocationID] = tcPosition [gl_InvocationID];
    teNormal   [gl_InvocationID] = tcNormal   [gl_InvocationID];
    teTexCoord [gl_InvocationID] = tcTexCoord [gl_InvocationID];

    // set tess-levels only once
    if (gl_InvocationID == 0)
    {
        vec4 e0 = uView * uModel * vec4(tcPosition[0],1);
        vec4 e1 = uView * uModel * vec4(tcPosition[1],1);
        vec4 e2 = uView * uModel * vec4(tcPosition[2],1);
        vec4 e3 = uView * uModel * vec4(tcPosition[3],1);

        float d0 = abs(e0.z), d1 = abs(e1.z), d2 = abs(e2.z), d3 = abs(e3.z);
        float s0 = smoothstep(MIN_DISTANCE, MAX_DISTANCE, d0);
        float s1 = smoothstep(MIN_DISTANCE, MAX_DISTANCE, d1);
        float s2 = smoothstep(MIN_DISTANCE, MAX_DISTANCE, d2);
        float s3 = smoothstep(MIN_DISTANCE, MAX_DISTANCE, d3);

        float tBottom = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), min(s1,s2));
        float tLeft   = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), min(s0,s1));
        float tTop    = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), min(s3,s0));
        float tRight  = mix(float(MAX_TESS_LEVEL), float(MIN_TESS_LEVEL), min(s2,s3));

        gl_TessLevelOuter[0] = tBottom;
        gl_TessLevelOuter[1] = tLeft;
        gl_TessLevelOuter[2] = tTop;
        gl_TessLevelOuter[3] = tRight;
        gl_TessLevelInner[0] = max(tLeft,  tRight);
        gl_TessLevelInner[1] = max(tTop,   tBottom);
    }
}
