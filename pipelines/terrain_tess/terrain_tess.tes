#version 410 core

// Define input patch type from Tessellator
layout(quads, equal_spacing, ccw) in; // Input is Quads from TCS

// Input from TCS (Control Points for the current patch)
in vec3 tePosition[]; // Array of 4 world-space positions (Y=0)
in vec2 teTexCoord[]; // Array of 4 texture coordinates (0..1)

// --- Uniforms ---
uniform mat4 uModel;
uniform mat4 uView;
uniform mat4 uProjection;
uniform sampler2D uHeightMap; // *** Sampler for the Heightmap ***
uniform float uYScale;        // Scale factor for heightmap value (from D code)
uniform float uYShift;        // Shift factor for heightmap value (from D code)

// --- Output to Fragment Shader ---
out vec3 vWorldPos; // Final calculated world position
out vec2 vTexCoord; // Final calculated texture coordinate
// out vec3 vNormal; // Normal calculation will be added later

// Helper for bilinear interpolation of a vec2 across the quad patch
vec2 interpolateV2(vec2 v0, vec2 v1, vec2 v2, vec2 v3) {
    // Using gl_TessCoord.x as 'u' and gl_TessCoord.y as 'v'
    // Assumes input order: 0=TL, 1=BL, 2=BR, 3=TR (matching D code index generation)
    vec2 p0 = mix(v0, v3, gl_TessCoord.x); // Interpolate top edge (TL->TR)
    vec2 p1 = mix(v1, v2, gl_TessCoord.x); // Interpolate bottom edge (BL->BR)
    return mix(p0, p1, gl_TessCoord.y);     // Interpolate vertically (Top->Bottom)
}

// Helper for bilinear interpolation of a vec3
vec3 interpolateV3(vec3 v0, vec3 v1, vec3 v2, vec3 v3) {
    // Assumes input order: 0=TL, 1=BL, 2=BR, 3=TR
    vec3 p0 = mix(v0, v3, gl_TessCoord.x); // Interpolate top edge
    vec3 p1 = mix(v1, v2, gl_TessCoord.x); // Interpolate bottom edge
    return mix(p0, p1, gl_TessCoord.y);     // Interpolate vertically
}

void main()
{
    // 1. Interpolate Texture Coordinates and base Position across the patch
    // Uses the te*[] arrays (control points from TCS) and gl_TessCoord (position within patch)
    // Ensure the order [0..3] matches the index order used in MakeTerrainPatchQuadGrid!
    // Let's assume the order TL(0), BL(1), BR(2), TR(3) based on likely index generation
    vTexCoord = interpolateV2(teTexCoord[0], teTexCoord[1], teTexCoord[2], teTexCoord[3]);
    vec3 basePos = interpolateV3(tePosition[0], tePosition[1], tePosition[2], tePosition[3]);

    // 2. Sample the heightmap texture using the interpolated coordinate
    // *** Sample the RED channel (.r) ***
    float heightSample = texture(uHeightMap, vTexCoord).r;

    // 3. Calculate the final world Y position using scale/shift from uniforms
    float worldY = heightSample * uYScale + uYShift;

    // 4. Calculate final World Position (displaced along Y)
    vWorldPos = vec3(basePos.x, worldY, basePos.z);

    // 5. TODO: Calculate the surface normal here later using heightmap samples or derivatives

    // 6. Calculate the final clip space position for this generated vertex
    gl_Position = uProjection * uView * uModel * vec4(vWorldPos, 1.0);
}